    "es-module-lexer": "3.0.4",
    "express": "5.3.0",
    "parse5": "8.0.1",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "qrcode": "1.5.4",
    "rrweb": "2.2.0",
    "rrweb-player": "2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
