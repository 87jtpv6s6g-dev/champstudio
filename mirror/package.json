{
  "name": "mirror",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mirror": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:fixtures": "vitest run --config vitest.e2e.config.ts",
    "e2e:site": "tsx test/e2e/site.e2e.ts"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "fast-check": "3.22.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
